        <intent android:action="com.pixelisland.CALIBRATE" android:targetPackage="com.pixelisland"
            android:targetClass="com.pixelisland.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="presets" android:enabled="true" android:icon="@drawable/ic_sc_presets"
        android:shortcutShortLabel="@string/sc_presets">
        <intent android:action="com.pixelisland.PRESETS" android:targetPackage="com.pixelisland"
            android:targetClass="com.pixelisland.MainActivity" />
    </shortcut>
</shortcuts>
