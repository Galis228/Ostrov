<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="toggle" android:enabled="true" android:icon="@drawable/ic_sc_toggle"
        android:shortcutShortLabel="@string/sc_toggle">
        <intent android:action="com.pixelisland.TOGGLE" android:targetPackage="com.pixelisland"
            android:targetClass="com.pixelisland.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="calibrate" android:enabled="true" android:icon="@drawable/ic_sc_calibrate"
